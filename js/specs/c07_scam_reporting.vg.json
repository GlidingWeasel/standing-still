{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Choropleth map of Australia showing, for each state and territory, the share of scam victims whose most serious scam was reported to an authority in 2024-2025. The ACT is highest at 89.2 percent and the only jurisdiction significantly above the national 71.1 percent.",
  "usermeta": {
    "chart": "C7",
    "idiom": "Choropleth map",
    "section": 3,
    "source": "ABS Personal Fraud 2024-25, Table 3a, Scams, Reporting rate"
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "conicEqualArea",
    "rotate": [-132, 0, 0],
    "parallels": [-18, -36],
    "fit": {
      "type": "Feature",
      "properties": {},
      "geometry": {
        "type": "MultiPoint",
        "coordinates": [[112.5, -10], [159.5, -10], [112.5, -44], [159.5, -44]]
      }
    }
  },
  "data": {
    "url": "data/geo/au-states.json",
    "format": {"type": "topojson", "feature": "au_states"}
  },
  "transform": [
    {"calculate": "geoCentroid(null, datum)", "as": "centroid"},
    {
      "lookup": "properties.state_name_2021",
      "from": {
        "data": {"url": "data/chartready/abs_fraud_by_state.csv"},
        "key": "state",
        "fields": ["state", "state_abbr", "scam_reporting_pct", "scams_000"]
      }
    },
    {
      "calculate": "toNumber(datum.scam_reporting_pct)",
      "as": "scam_reporting_pct"
    },
    {"calculate": "toNumber(datum.scams_000)", "as": "scams_000"},
    {
      "calculate": "format(datum.scam_reporting_pct, '.1f') + '%'",
      "as": "value_label"
    },
    {
      "calculate": "datum.state_abbr === 'Tas' ? 151.4 : datum.centroid[0]",
      "as": "label_lon"
    },
    {
      "calculate": "datum.state_abbr === 'Tas' ? -42.2 : datum.centroid[1]",
      "as": "label_lat"
    }
  ],
  "layer": [
    {
      "name": "states",
      "mark": {"type": "geoshape", "stroke": "#F7F5F2", "strokeWidth": 1},
      "encoding": {
        "color": {
          "field": "scam_reporting_pct",
          "type": "quantitative",
          "scale": {"domain": [60, 90], "scheme": "teals"},
          "legend": {
            "title": "Worst scam reported, 2024-2025 (%)",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleLimit": 340
          }
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or territory"},
          {
            "field": "scam_reporting_pct",
            "type": "quantitative",
            "title": "Worst scam reported (%)",
            "format": ".1f"
          },
          {
            "field": "scams_000",
            "type": "quantitative",
            "title": "Scam victims ('000)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "name": "act_leader",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {"type": "rule", "color": "#7A756D", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"datum": 149.1},
        "latitude": {"datum": -35.5},
        "longitude2": {"datum": 154.7},
        "latitude2": {"datum": -36.3}
      }
    },
    {
      "name": "act_square",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {
        "type": "square",
        "size": 260,
        "opacity": 1,
        "stroke": "#7A756D",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {"datum": 155.4},
        "latitude": {"datum": -36.4},
        "color": {
          "field": "scam_reporting_pct",
          "type": "quantitative",
          "scale": {"domain": [60, 90], "scheme": "teals"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or territory"},
          {
            "field": "scam_reporting_pct",
            "type": "quantitative",
            "title": "Worst scam reported (%)",
            "format": ".1f"
          },
          {
            "field": "scams_000",
            "type": "quantitative",
            "title": "Scam victims ('000)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "name": "act_label",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "dy": -8,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#14161A"
      },
      "encoding": {
        "longitude": {"datum": 155.4},
        "latitude": {"datum": -36.4},
        "text": {"field": "state_abbr", "type": "nominal"}
      }
    },
    {
      "name": "act_value",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "dy": 8,
        "fontSize": 12,
        "color": "#14161A"
      },
      "encoding": {
        "longitude": {"datum": 155.4},
        "latitude": {"datum": -36.4},
        "text": {"field": "value_label", "type": "nominal"}
      }
    },
    {
      "name": "state_labels",
      "transform": [{"filter": "datum.state_abbr !== 'ACT'"}],
      "mark": {"type": "text", "dy": -8, "fontSize": 13, "fontWeight": 600},
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "text": {"field": "state_abbr", "type": "nominal"},
        "color": {
          "condition": {
            "test": "datum.scam_reporting_pct >= 76 && datum.state_abbr !== 'Tas'",
            "value": "#F7F5F2"
          },
          "value": "#14161A"
        }
      }
    },
    {
      "name": "state_values",
      "transform": [{"filter": "datum.state_abbr !== 'ACT'"}],
      "mark": {"type": "text", "dy": 8, "fontSize": 12},
      "encoding": {
        "longitude": {"field": "label_lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "text": {"field": "value_label", "type": "nominal"},
        "color": {
          "condition": {
            "test": "datum.scam_reporting_pct >= 76 && datum.state_abbr !== 'Tas'",
            "value": "#F7F5F2"
          },
          "value": "#14161A"
        }
      }
    },
    {
      "name": "callout_text",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 12,
        "fontWeight": 600,
        "lineBreak": "|",
        "lineHeight": 15,
        "color": "#14161A"
      },
      "encoding": {
        "longitude": {"datum": 154.9},
        "latitude": {"datum": -44.9},
        "text": {
          "value": "Only the ACT is|significantly above the|national 71.1 percent"
        }
      }
    },
    {
      "name": "callout_arrow",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {"type": "rule", "strokeWidth": 1.5, "color": "#14161A"},
      "encoding": {
        "longitude": {"datum": 155.45},
        "latitude": {"datum": -44.9},
        "longitude2": {"datum": 155.45},
        "latitude2": {"datum": -38}
      }
    },
    {
      "name": "callout_head",
      "transform": [{"filter": "datum.state_abbr === 'ACT'"}],
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "size": 45,
        "color": "#14161A",
        "opacity": 1
      },
      "encoding": {"longitude": {"datum": 155.45}, "latitude": {"datum": -37.9}}
    }
  ]
}
